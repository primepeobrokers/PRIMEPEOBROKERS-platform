    "test:unit": "npx tsx scripts/test-unit.mts",
    "email:preview": "npx tsx --conditions=react-server scripts/preview-email.mts",
    "check:storage": "npx tsx scripts/check-storage.mts",
    "test:integration": "npx tsx scripts/test-integration.mts",
    "test:cleanup": "npx tsx scripts/test-integration.mts --cleanup",
    "test": "npx tsx scripts/test-unit.mts && npx tsx scripts/test-integration.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
